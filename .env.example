# Copy to .env next to docker-compose.yml and keep it private.
SSH_USER=admin
SSH_PASSWORD=changeme
# SSH_KEY_FILE=/data/id_ed25519   # use instead of a password
# SSH_PORT=22

# Web UI login (HTTP Basic, on by default). Leave UI_PASSWORD blank to have one generated on first start;
# it is printed once in the container log (docker compose logs).
# UI_USER=admin
# UI_PASSWORD=choose-something
# UI_AUTH=off          # only if your reverse proxy handles the login
# TRUST_PROXY=1        # set behind a reverse proxy
# BIND_ADDR=127.0.0.1  # when the proxy runs on this same host

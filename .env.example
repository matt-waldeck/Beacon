# Beacon settings. Copy to .env next to docker-compose.yml and keep it private.
SSH_USER=admin
SSH_PASSWORD=changeme
# SSH_KEY_FILE=/data/id_ed25519   # use instead of a password
# SSH_PORT=22

# Sign-in. Beacon creates an admin account on first start. Leave UI_PASSWORD blank and a random
# password is printed once in the container log (docker compose logs). Add more users, a guest
# profile and branding in Settings once you're in.
# UI_USER=admin
# UI_PASSWORD=choose-something   # when set, always resets UI_USER's password at start (handy if you forget it)
# UI_AUTH=off          # no sign-in at all; only if your reverse proxy handles it
# TRUST_PROXY=1        # set behind a reverse proxy
# COOKIE_SECURE=1      # set when Beacon is served over HTTPS
# BIND_ADDR=127.0.0.1  # when the proxy runs on this same host

# GITHUB_REPO=matt-waldeck/beacon   # where Settings > Feedback opens issues

# App icons are looked up by Beacon itself (Heimdall's app list, then Dashboard Icons, then selfh.st) and kept in ./data/icons.
# For an air-gapped setup, point these at your own mirrors:
# HEIMDALL_SOURCE=https://appslist.heimdall.site
# DASHBOARD_ICONS_SOURCE=https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons
# SELFHST_ICONS_SOURCE=https://cdn.jsdelivr.net/gh/selfhst/icons

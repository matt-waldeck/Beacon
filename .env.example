# Beacon settings. Copy to .env next to docker-compose.yml and keep it private.
SSH_USER=admin
SSH_PASSWORD=changeme
# SSH_KEY_FILE=/data/id_ed25519   # use instead of a password
# SSH_PORT=22

# UniFi Network API. Sites are normally added in Settings > UniFi, where you can add as many as you like and
# choose how often Beacon looks for new devices. These variables are the older way and add one more site, listed
# there as "Environment". Create the API key in the Network application under Settings > Control Plane > Integrations.
# With a site set up, Beacon reads CPU, memory, load, throughput and client counts from the controller instead of
# logging in to every device over SSH; devices it doesn't know are still checked over SSH (keep the login above).
# UNIFI_URL=https://192.168.1.10:8443
# UNIFI_API_KEY=
# UNIFI_SITE=default      # the site's name, internal name or ID
# UNIFI_VERIFY_TLS=1      # check the controller's certificate; leave off for the self-signed one it ships with

# Sign-in. Leave UI_PASSWORD blank and Beacon shows a setup page on first visit, where you create
# the admin account (name, email, password). Add more users, a guest profile and branding in
# Settings once you're in.
# UI_USER=admin
# UI_PASSWORD=choose-something   # when set, always resets UI_USER's password at start (handy if you forget it)
# UI_AUTH=off          # no sign-in at all; only if your reverse proxy handles it
# TRUST_PROXY=1        # set behind a reverse proxy
# COOKIE_SECURE=1      # set when Beacon is served over HTTPS
# BIND_ADDR=127.0.0.1  # when the proxy runs on this same host

# GITHUB_REPO=matt-waldeck/beacon   # where Settings > Feedback opens issues

# App icons are looked up by Beacon itself (selfh.st by default; change it in Settings > About) and kept in ./data/icons.
# For an air-gapped setup, point these at your own mirrors:
# SELFHST_ICONS_SOURCE=https://cdn.jsdelivr.net/gh/selfhst/icons
# DASHBOARD_ICONS_SOURCE=https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons
